{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "replace-with-worker-name",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",
  "workers_dev": true,
  "preview_urls": false,
  "kv_namespaces": [
    {
      "binding": "KV_StarHistory",
      "id": "replace-with-kv-namespace-id"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
